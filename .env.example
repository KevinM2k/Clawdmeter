# Clawdmeter daemon settings.
#
#   cp .env.example .env      then edit .env — it is gitignored, so your paths
#                             never end up in a commit.
#
# Precedence, highest first:
#   1. a real environment variable of the same name (handy in a launchd plist
#      or systemd unit, and for one-off runs: CLAWDMETER_POLL_INTERVAL=30 ...)
#   2. this .env file
#   3. ~/.config/claude-usage-monitor/config   (what ./install-mac.sh writes)
#   4. the built-in defaults noted below
#
# NO SECRETS BELONG HERE. The daemon reads your Claude OAuth token at runtime
# from the macOS Keychain (service "Claude Code-credentials-<hash>") or from
# <config dir>/.credentials.json on Linux/Windows. Nothing about a token is
# ever written to this file or to the repo.


# --- Which Claude accounts to show -----------------------------------------
# Comma-separated list of Claude config dirs. The daemon polls each one and the
# display shows whichever plan you are actively using; swipe on the device to
# page between them. Leave unset to poll just ~/.claude.
#
# These are the dirs you select with CLAUDE_CONFIG_DIR when launching Claude
# Code, e.g. `CLAUDE_CONFIG_DIR=~/.claude-work claude`. To list the ones you
# already have:
#     ls -d ~/.claude*
# Any name works — the page label comes from that account's `subscriptionType`
# (Team / Pro / Max / Enterprise), falling back to the dir's own suffix, so
# ~/.claude-side shows as "Side". ~ is expanded. Max 3 dirs (the payload has to
# fit the device's 512-byte BLE buffer).
# Default: ~/.claude
#CLAWDMETER_CONFIG_DIRS=~/.claude, ~/.claude-personal


# --- Session-reset chime ---------------------------------------------------
# Sound the board's speaker when your 5-hour session limit resets, so you know
# you can use Claude again without watching the screen.
# Values: on | off      (boards with audio: AMOLED-2.16 / 1.8)
# Default: off
#CLAWDMETER_CHIME=off


# --- Clock on the usage screen ---------------------------------------------
# Shows the time in place of the "Usage" title.
#   off   no clock (default)
#   auto  detect 12h/24h from this machine — note detection can land on 24h
#         when the daemon runs under launchd with no locale, so set 12 or 24
#         explicitly if auto guesses wrong
#   12    forced 12-hour, e.g. 6:28 PM
#   24    forced 24-hour, e.g. 18:28
#CLAWDMETER_CLOCK=off


# --- How often usage is refreshed ------------------------------------------
# Seconds between polls of the Anthropic API. Each poll is one 1-token Haiku
# request, so it is close to free, but the numbers on screen can be up to this
# many seconds stale. Lower it if a minute of lag bothers you.
# Requires a daemon restart. Default: 60
#CLAWDMETER_POLL_INTERVAL=60

# Seconds between inner loop ticks — how quickly a BLE disconnect is noticed.
# Rarely worth changing. Requires a daemon restart. Default: 5
#CLAWDMETER_TICK=5


# --- Per-model ("scoped") limit, e.g. the Fable weekly window --------------
# That limit comes from api.anthropic.com/api/oauth/usage, which the ordinary
# rate-limit response headers do not carry. It answers HTTP 429 aggressively,
# and the window it reports is weekly, so the value is cached rather than
# fetched every cycle. On a refusal the last known value is reused, so the row
# will not blink out; a successful response reporting no scoped limit does
# clear it.
# Seconds between successful refreshes. Requires a restart. Default: 600
#CLAWDMETER_SCOPED_TTL=600

# Seconds to wait before retrying after a refusal. Lower it and you will simply
# collect more 429s. Requires a restart. Default: 120
#CLAWDMETER_SCOPED_RETRY=120


# --- BLE device name -------------------------------------------------------
# Must match the name the firmware advertises. Only change this if you also
# changed DEVICE_NAME in firmware/src/ble.cpp; otherwise the daemon will not
# find your board. Requires a restart. Default: Clawdmeter
#CLAWDMETER_DEVICE_NAME=Clawdmeter
